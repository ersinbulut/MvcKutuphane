@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- FontAwesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f5f6fa;
        }

        /* Sidebar */
        .sidebar {
            height: 100vh;
            width: 250px;
            position: fixed;
            left: 0;
            top: 0;
            background: #1b1f27;
            padding-top: 25px;
            overflow-y: auto;
        }

        .sidebar a {
            padding: 12px 20px;
            display: block;
            font-size: 16px;
            color: #ddd;
            text-decoration: none;
            transition: 0.2s;
        }

            .sidebar a:hover {
                background: #0d6efd;
                color: #fff;
            }

            .sidebar a i {
                width: 22px;
            }

        /* Main content */
        .main {
            margin-left: 250px;
            padding: 25px;
        }

        /* Responsive */
        media (max-width: 768px) {
            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
            }

            .main {
                margin-left: 0;
            }
        }
    </style>

</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">

        <a href="/istatistik/Index/"><i class="fa-solid fa-house"></i> Ana Sayfa</a>
        <a href="/Kategori/Index/"><i class="fa-solid fa-list"></i> Kategoriler</a>
        <a href="/Kitap/Index/"><i class="fa-solid fa-book"></i> Kitaplar</a>
        <a href="/Yazar/Index/"><i class="fa-solid fa-pen-nib"></i> Yazarlar</a>
        <a href="/Uye/Index/"><i class="fa-solid fa-user"></i> Üyeler</a>
        <a href="/Personel/Index/"><i class="fa-solid fa-building"></i> Personeller</a>
        @if (User.IsInRole("A"))
        {
            <a href="/Odunc/OduncVer/"><i class="fa-solid fa-arrow-right"></i> Ödünç Kitap Ver</a>
            <a href="/Odunc/Index/"><i class="fa-solid fa-arrow-left"></i> Ödünç Kitap Al</a>
        }

        <a href="/İstatistik/Index/"><i class="fa-solid fa-chart-column"></i> İstatistikler</a>
        <a href="/Duyuru/Index/"><i class="fa-solid fa-bullhorn"></i> Duyurular</a>

        <a href="/islem/index/"><i class="fa-solid fa-gauge"></i> İşlemler</a>
        <a href="/İstatistik/Hava/"><i class="fa-solid fa-cloud"></i> Hava</a>
        <a href="/İstatistik/HavaKart/"><i class="fa-solid fa-plus"></i> Hava Kartları</a>
        <a href="/İstatistik/Galeri/"><i class="fa-solid fa-image"></i> Galeri</a>
        <a href="/İstatistik/LinqKart/"><i class="fa-solid fa-bookmark"></i> Linq Kartlar</a>

        <a href="/vitrin/Index/"><i class="fa-solid fa-gift"></i> Vitrin</a>
        <a href="/Grafik/Index/"><i class="fa-solid fa-chart-pie"></i> Grafikler</a>

        <a href="/Ayarlar/Index2/"><i class="fa-solid fa-gear"></i> Ayarlar</a>
        <a href="#"><i class="fa-solid fa-phone"></i> Yardım</a>
        <a href="/Panelim/LogOut/"><i class="fa-solid fa-right-from-bracket"></i> Çıkış</a>

    </div>

    <!-- Main Content -->
    <div class="main">
        @RenderBody()
    </div>

</body>
</html>
