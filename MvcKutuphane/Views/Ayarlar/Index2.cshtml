@model List<MvcKutuphane.Models.Entity.TBLADMIN>
@{
    ViewBag.Title = "Admin Yönetimi";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<!-- Bootstrap 5 için gerekli JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<h2 class="mb-4">Admin Yönetimi</h2>

<!-- Admin Tablosu -->
<div class="card shadow-sm">
    <div class="card-body">

        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Kullanıcı Adı</th>
                    <th>Yetki</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var admin in Model)
                {
                    <tr>
                        <td>@admin.ID</td>
                        <td>@admin.Kullanici</td>
                        <td>@admin.Yetki</td>
                        <td class="text-center">
                            <a href="@Url.Action("AdminGuncelle", "Ayarlar", new { id = admin.ID })" class="btn btn-sm btn-primary me-1">
                                <i class="fa-solid fa-pen"></i> Düzenle
                            </a>
                            <a href="@Url.Action("AdminSil", "Ayarlar", new { id = admin.ID })"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Bu admin silinsin mi?');">
                                <i class="fa-solid fa-trash"></i> Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Yeni Admin Ekle Butonu -->
        <button class="btn btn-success mt-3" data-bs-toggle="modal" data-bs-target="#YeniAdminModal">
            <i class="fa-solid fa-user-plus"></i> Yeni Admin Ekle
        </button>

    </div>
</div>


<!-- Modal: Yeni Admin Ekle -->
<div class="modal fade" id="YeniAdminModal" tabindex="-1" aria-labelledby="YeniAdminLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="YeniAdminLabel">Yeni Admin Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" action="/Ayarlar/YeniAdmin/">
                <div class="modal-body">

                    <label class="fw-bold">Kullanıcı Adı</label>
                    <input type="text" name="Kullanici" class="form-control mb-3" required />

                    <label class="fw-bold">Şifre</label>
                    <input type="password" name="Sifre" class="form-control mb-3" required />

                    <label class="fw-bold">Yetki</label>
                    <input type="text" name="Yetki" class="form-control mb-2" required />

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Kaydet</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                </div>
            </form>

        </div>
    </div>
</div>
